{
  "name": "theartist",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A persistent studio harness for an autonomous artist or configurable founder",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "studio": "tsx src/cli.ts",
    "demo": "tsx src/cli.ts demo",
    "demo:founder": "tsx src/cli.ts demo --studio founder",
    "cloudflare:deploy": "tsx src/cli.ts publish",
    "cloudflare:dev": "wrangler dev --config cloudflare/wrangler.jsonc",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "openai": "^7.15.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "wrangler": "^4.131.1"
  }
}
